DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartride
# Set DB_URL instead when connecting to a hosted database.
# DB_URL=jdbc:postgresql://localhost:5432/smartride
DB_USERNAME=smartride
DB_PASSWORD=
DB_POOL_MAX_SIZE=3
DB_POOL_MIN_IDLE=0
DB_CONNECTION_TIMEOUT_MS=30000
DB_CONNECTION_MAX_LIFETIME_MS=600000
# Generate a random JWT secret of at least 32 bytes for your local .env.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
SERVER_PORT=8080
ADMIN_EMAIL=admin@smartride.com
ADMIN_PASSWORD=
ADMIN_NAME=SmartRide Administrator
ADMIN_INITIALIZATION_ENABLED=true
SMARTRIDE_DRIVER_UPLOAD_DIR=./private-uploads/drivers
SMARTRIDE_CUSTOMER_KYC_UPLOAD_DIR=./private-uploads/customer-kyc
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
FRONTEND_URL=http://localhost:5173