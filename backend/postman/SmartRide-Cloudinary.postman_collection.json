{
  "info": { "name": "SmartRide Cloudinary uploads", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [ { "key": "baseUrl", "value": "http://localhost:8080" }, { "key": "token", "value": "paste-vendor-jwt" }, { "key": "vehicleId", "value": "1" }, { "key": "mediaId", "value": "1" }, { "key": "documentId", "value": "1" } ],
  "item": [
    { "name": "1 Vendor registration", "request": { "method": "POST", "url": "{{baseUrl}}/api/vendor/auth/register", "body": { "mode": "formdata", "formdata": [ { "key": "application", "type": "text", "contentType": "application/json", "value": "{\"fullName\":\"Vendor Example\",\"email\":\"vendor@example.com\",\"mobileNumber\":\"9876543210\",\"password\":\"StrongPass1!\",\"confirmPassword\":\"StrongPass1!\",\"businessName\":\"Example Fleet\",\"businessType\":\"Rental\",\"businessEmail\":\"fleet@example.com\",\"businessMobile\":\"9876543210\",\"businessAddress\":\"Example address\",\"city\":\"Pune\",\"state\":\"Maharashtra\",\"pincode\":\"411001\",\"termsAccepted\":true,\"vendorPoliciesAccepted\":true}" }, { "key": "profileImage", "type": "file", "src": "" }, { "key": "identityProof", "type": "file", "src": "" }, { "key": "panCard", "type": "file", "src": "" }, { "key": "businessDocument", "type": "file", "src": "" }, { "key": "addressProof", "type": "file", "src": "" } ] } } },
    { "name": "2 Vendor document upload", "request": { "method": "POST", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": "{{baseUrl}}/api/vendor/documents", "body": { "mode": "formdata", "formdata": [ { "key": "documentType", "type": "text", "value": "BUSINESS_REGISTRATION" }, { "key": "document", "type": "file", "src": "" } ] } } },
    { "name": "3 Multiple vehicle photos", "request": { "method": "POST", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": "{{baseUrl}}/api/vendor/vehicles/{{vehicleId}}/media", "body": { "mode": "formdata", "formdata": [ { "key": "photos", "type": "file", "src": "" }, { "key": "photos", "type": "file", "src": "" } ] } } },
    { "name": "4 Vehicle RC insurance PUC", "request": { "method": "POST", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": "{{baseUrl}}/api/vendor/vehicles/{{vehicleId}}/media", "body": { "mode": "formdata", "formdata": [ { "key": "registrationDocuments", "type": "file", "src": "" }, { "key": "insuranceDocuments", "type": "file", "src": "" }, { "key": "pucDocuments", "type": "file", "src": "" } ] } } },
    { "name": "5 Retrieve vehicle media list", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": "{{baseUrl}}/api/vendor/vehicles/{{vehicleId}}/media" } },
    { "name": "6 Retrieve vendor document", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": "{{baseUrl}}/api/vendor/documents/{{documentId}}" } },
    { "name": "7 Delete vehicle media", "request": { "method": "DELETE", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": "{{baseUrl}}/api/vendor/vehicles/{{vehicleId}}/media/{{mediaId}}" } },
    { "name": "Delete vendor document", "request": { "method": "DELETE", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": "{{baseUrl}}/api/vendor/documents/{{documentId}}" } }
  ]
}
